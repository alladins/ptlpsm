# 데모 환경 설정 (솔루션 쇼케이스)
# 도메인: demo.platree.com (별도 도메인 — 서브패스 아님)
# 포트: 9033 (nginx 데모 서버블록이 /api → :9033 프록시)
# 제약: 이 파일은 generate:demo 전용. dev/prod 빌드 산출물에 영향 없음.

# 정적 빌드는 운영과 동일한 production 모드로 생성 (SSG)
NODE_ENV=production

# API 설정 (nginx 프록시 경로 사용 - Mixed Content 방지)
# demo.platree.com 은 services/api.ts 기본 분기로 '/api' 반환 → nginx 데모 서버블록이 :9033 백엔드로 프록시
NUXT_PUBLIC_API_BASE_URL=/api

# 사이트 설정
NUXT_PUBLIC_SITE_URL=https://demo.platree.com
NUXT_PUBLIC_SITE_NAME=플랫트리 출하관리 데모

# 데모 모드 플래그 (검증 H1) — true 일 때만 데모 전용 동작(파괴적 버튼 숨김·플로팅 CTA 등) 활성화
# 기본값 false (nuxt.config.ts). 이 값이 true 인 빌드는 오직 generate:demo 산출물뿐.
NUXT_PUBLIC_DEMO_MODE=true

# 데모 공용 계정 (D4) — 랜딩 "데모 시작" 버튼이 이 고정 계정으로 자동 로그인.
# ⚠️ NUXT_PUBLIC_* 라 클라이언트 번들에 노출됨. 공개 데모 계정이므로 의도된 노출(누구나 사용 가능).
# ⚠️ 시드 데이터(Task #5)에 반드시 아래와 동일한 loginId/비밀번호의 LEADPOWER_MANAGER 계정을 생성할 것(최종 확정값: demo / demo1234! — 시드 bcrypt 해시 기준).
NUXT_PUBLIC_DEMO_LOGIN_ID=demo
NUXT_PUBLIC_DEMO_LOGIN_PW=demo1234!

# 문의 CTA 링크 (D2) — 데모 내 모든 CTA는 플랫트리 홈페이지 문의 페이지로 링크(데모 자체 접수 미개발).
# ⚠️ placeholder — 플랫트리 홈페이지 "도입 문의하기" 실제 URL 확정 시 교체할 것(D5).
# UTM 파라미터는 컴포넌트(DemoFloatingCta)에서 자동 부착하므로 여기엔 순수 base URL 만.
NUXT_PUBLIC_INQUIRY_URL=https://platree.com/inquiry

# topgrid Pro 차트 라이선스 (D3: 1차 워터마크 감수 → 공란으로 시작)
# 키 미설정 시 차트는 정상 동작하고 "Unlicensed" 워터마크만 표시됨(nuxt.config.ts 폴백).
# 정식 키 적용 시: base64 페이로드의 domain 이 demo.platree.com 인지 반드시 검증할 것(도메인 불일치 키는 무에러·워터마크만 → 오탐 주의).
NUXT_PUBLIC_TOPGRID_LICENSE_KEY=

# 참고: Google Ads 태그(AW-16935488485, app.vue 하드코딩)는 demoMode 게이팅으로 데모 빌드에서 미주입 처리됨(2026-07-08).
# 데모 트래픽은 GA/전환 픽셀에 잡히지 않음 — 데모 유입 측정은 UTM+백엔드 방문자 추적(ptlpsm_demo)으로.
