NODE_ENV=production

# API 설정 (nginx 프록시 경로 사용 - Mixed Content 방지)
NUXT_PUBLIC_API_BASE_URL=/api

# 사이트 설정
NUXT_PUBLIC_SITE_URL=https://shipmg.lphydrofoam.com
NUXT_PUBLIC_SITE_NAME=PTLPSM

# topgrid Pro 차트 라이선스 — 운영 도메인(shipmg.lphydrofoam.com) 키 발급 후 입력할 것 (미입력 시 워터마크만 표시, 기능 정상)
NUXT_PUBLIC_TOPGRID_LICENSE_KEY=
